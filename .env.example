# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safebot?sslmode=disable

# Telegram bot token from @BotFather (required). Create your own test bot.
BOT_TOKEN=

# Random secret shared with Telegram via setWebhook(secret_token=...) (required).
# Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# HTTP port (optional, defaults to 8080)
PORT=8080
